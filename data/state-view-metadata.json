  "stateMetadata": [
    {
      "stateId": 1,
      "canonicalInterpretation": "A beginning need not be empty of experience. Innocence invites fresh attention without requiring the Persona to forget what has been learned.",
      "visualIdentity": {
        "hue": "#b6c2ae",
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
      "traditionalReference": null
    },
    {
      "stateId": 2,
      "canonicalInterpretation": "Seeking gives longing a direction. Notice whether the search makes room for discovery or already demands a particular answer.",
      "visualIdentity": {
        "hue": null,
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
      "traditionalReference": null
    },
    {
      "stateId": 3,
      "canonicalInterpretation": "Discipline gives intention a repeatable form. Its question is whether a chosen rhythm sustains attention while remaining responsive to life.",
      "visualIdentity": {
        "hue": "#b8b1a0",
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
      "traditionalReference": {
        "sanskritName": "Krodha",
        "englishName": "Anger",
        "coreMeaning": "Heat narrows attention around an obstacle.",
        "traditionalInterpretation": "Anger can expose a hurt or boundary; identifying wholly with it may conceal other possible responses.",
        "transition": null
      }
    },
    {
      "stateId": 4,
      "canonicalInterpretation": "Compassion recognises another’s difficulty without surrendering discernment. Care may take the form of presence, help, or a clear boundary.",
      "visualIdentity": {
        "hue": null,
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
      "traditionalReference": null
    },
    {
      "stateId": 5,
      "canonicalInterpretation": "Pride gathers identity around what has been achieved. Recognition can be received without making it the sole measure of worth.",
      "visualIdentity": {
        "hue": "#c0a98e",
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
      "traditionalReference": null
    },
    {
      "stateId": 6,
      "canonicalInterpretation": "Acceptance begins by acknowledging what is already present. Seeing a situation clearly can make deliberate action possible.",
      "visualIdentity": {
        "hue": null,
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
      "traditionalReference": null
    },
    {
      "stateId": 7,
      "canonicalInterpretation": "Discernment listens for what matters among competing impressions. Clarity grows through attention to consequences as well as intentions.",
      "visualIdentity": {
        "hue": null,
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
      "traditionalReference": null
    },
    {
      "stateId": 8,
      "canonicalInterpretation": "Surrender loosens an insistence on controlling every outcome. Responsibility can remain while the demand for certainty softens.",
      "visualIdentity": {
        "hue": null,
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
      "traditionalReference": null
    },
    {
      "stateId": 9,
      "canonicalInterpretation": "Integration tests whether insight can live in ordinary habits. A small consistent action may carry an understanding further than explanation.",
      "visualIdentity": {
        "hue": null,
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
      "traditionalReference": null
    },
    {
      "stateId": 10,
      "canonicalInterpretation": "Liberation invites a wider view of the roles and patterns in play. Seeing a pattern can create room to respond differently.",
      "visualIdentity": {
        "hue": null,
        "imageAsset": null,
        "symbol": null,
        "element": null
      },
